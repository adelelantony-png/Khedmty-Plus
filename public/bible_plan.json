JavaScript
// 1. سد الثغرة الأمنية بمنع الدخول بدون كود حقيقي
const studentCode = localStorage.getItem('student_code');
if (!studentCode) window.location.href = 'index.html';

/* ... اترك الأكواد الخاصة بالترحيل والمتغيرات العامة كما هي ... */

// 2. دمج الخطة الاحتياطية لتتطابق مع الصفحة الرئيسية
async function detectTodayPlan() {
    const now = new Date();
    const curMonth = now.getMonth() + 1;
    const curDay = now.getDate();
    const planKey = `${curMonth}-${curDay}`;

    let planData = window.BIBLE_PLAN_DATA || null;

    if (!planData) {
        try {
            const res = await fetch('bible_plan.json');
            if (res.ok) planData = await res.json();
        } catch(e) {}
    }

    // إضافة الخطة المفقودة
    if (!planData || !planData[planKey]) {
        const fallbackQuickMap = {
            "10-1": { reading: "سفر يونان (الإصحاحات 1 إلى 4)", book: "يونان", chapter: 1, chapter_end: 4 },
            "10-2": { reading: "سفر ميخا (الإصحاحات 1 إلى 3)", book: "ميخا", chapter: 1, chapter_end: 3 },
            "10-3": { reading: "سفر ميخا (الإصحاحات 4 إلى 7)", book: "ميخا", chapter: 4, chapter_end: 7 },
            "10-4": { reading: "سفر ناحوم (الإصحاحات 1 إلى 3)", book: "ناحوم", chapter: 1, chapter_end: 3 },
            "10-5": { reading: "سفر حبقوق (الإصحاحات 1 إلى 3)", book: "حبقوق", chapter: 1, chapter_end: 3 },
            "10-6": { reading: "سفر صفنيا (الإصحاحات 1 إلى 3)", book: "صفنيا", chapter: 1, chapter_end: 3 },
            "10-7": { reading: "سفر حجي (الإصحاحات 1 إلى 2)", book: "حجي", chapter: 1, chapter_end: 2 }
        };
        if (fallbackQuickMap[planKey]) {
            if (!planData) planData = {};
            planData[planKey] = fallbackQuickMap[planKey];
        }
    }

    const bannerTitle = document.getElementById('planBannerTitle');
    const localLogs = JSON.parse(localStorage.getItem('khedmety_bible_readings')) || {};
    const isCompleted = !!localLogs[`${planKey}_${studentCode}`];

    if (planData && planData[planKey]) {
        const item = planData[planKey];
        bannerTitle.textContent = `${item.reading} (${item.book} من إصحاح ${item.chapter} إلى ${item.chapter_end || item.chapter})`;

        if (!targetBookName) {
            targetBookName = item.book;
            targetChapter = item.chapter;
            targetChapterEnd = item.chapter_end || item.chapter;
        }
    } else {
        bannerTitle.textContent = "قراءة وتأمل حر";
    }

    if (isCompleted) {
        const btnMark = document.getElementById('btnMarkRead');
        btnMark.className = 'btn btn-outline-success fw-bold px-3 py-2';
        btnMark.innerHTML = '<i class="fa-solid fa-check-double me-1"></i> أتممت قراءة هذا اليوم بنجاح ✔️';
    }
}

// 3. توحيد نظام حساب النقاط
async function markCurrentChapterRead() {
    const btnMark = document.getElementById('btnMarkRead');
    btnMark.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري التسجيل...';
    btnMark.disabled = true;

    const now = new Date();
    const curMonth = now.getMonth() + 1;
    const curDay = now.getDate();
    const planKey = `${curMonth}-${curDay}`;

    const bookIndex = document.getElementById('bookSelect').value;
    const chapNum = parseInt(document.getElementById('chapterSelect').value) + 1;
    const book = bibleData[bookIndex];
    const bookTitle = arabicBookNames[book.name] || book.name;

    let localReadings = JSON.parse(localStorage.getItem('khedmety_bible_readings')) || {};
    localReadings[`${planKey}_${studentCode}`] = {
        code: String(studentCode),
        book: bookTitle,
        chapter: chapNum,
        date: now.toISOString(),
        completed: 1
    };
    localStorage.setItem('khedmety_bible_readings', JSON.stringify(localReadings));

    // تم حذف السطر الذي كان يضيف 5 نقاط لمتغير student_points بشكل مستقل

    try {
        await fetch('/api/mark_plan_read', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                code: studentCode,
                month: curMonth,
                day: curDay,
                reading: `${bookTitle} ${chapNum}`
            })
        });
    } catch (e) {
        console.warn("تم الحفظ محلياً لتعذر الاتصال بالسيرفر:", e);
    }

    btnMark.className = 'btn btn-outline-success fw-bold px-3 py-2';
    btnMark.innerHTML = '<i class="fa-solid fa-check-double me-1"></i> أتممت قراءة اليوم بنجاح (+2 نقطة ⭐)';
    btnMark.disabled = false;
}
